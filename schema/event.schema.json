{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ciaranpflanagan/interactive-ww2-map/schema/event.schema.json",
  "title": "Event",
  "description": "One historical event (operation, battle, landing, sector action...). Every fact shown to users carries a `cite` array. See CLAUDE.md > Sourcing rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "review", "time", "geometry", "summary", "zoom"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Slug; must equal the file name." },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["campaign", "operation", "battle", "landing", "airborne", "naval", "air", "action", "atrocity", "other"] },
    "parent": { "type": "string", "description": "id of the containing event (e.g. omaha-beach -> normandy-landings)." },
    "wikidata": { "type": "string", "pattern": "^Q[0-9]+$" },
    "wikipedia": { "type": "string", "format": "uri" },
    "zoom": {
      "type": "object", "additionalProperties": false, "required": ["min"],
      "description": "Map zoom range in which the marker is shown (level-of-detail).",
      "properties": { "min": { "type": "number", "minimum": 0, "maximum": 22 }, "max": { "type": "number", "minimum": 0, "maximum": 22 } }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": { "enum": ["unreviewed", "agent-checked", "approved"], "description": "unreviewed: imported/drafted. agent-checked: source-checker agent verified every cite. approved: the maintainer approved it in a PR." },
        "by": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "time": {
      "type": "object", "additionalProperties": false, "required": ["start", "precision", "cite"],
      "properties": {
        "start": { "$ref": "#/$defs/isoTime" },
        "end": { "$ref": "#/$defs/isoTime" },
        "precision": { "enum": ["minute", "hour", "day", "month", "year"] },
        "cite": { "$ref": "#/$defs/cites" }
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false, "required": ["type", "coordinates", "accuracy", "cite"],
      "properties": {
        "type": { "enum": ["Point", "LineString", "Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array", "description": "GeoJSON coordinates, [longitude, latitude] order." },
        "accuracy": { "enum": ["precise", "approximate", "representative"], "description": "representative = a single point standing in for an area (e.g. Wikidata's one coordinate for a whole battle)." },
        "cite": { "$ref": "#/$defs/cites" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["text", "cite"],
      "properties": { "text": { "type": "string", "minLength": 1 }, "cite": { "$ref": "#/$defs/cites" } }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "value", "cite"],
        "properties": {
          "label": { "type": "string", "description": "e.g. 'US casualties', 'Troops landed', 'Commander (US)'" },
          "value": { "type": "string", "description": "Display text, e.g. '~2,000–5,000'. Ranges are preferred where sources disagree." },
          "low": { "type": "number" },
          "high": { "type": "number" },
          "side": { "type": "string" },
          "disputed": { "type": "boolean", "description": "true when reputable sources materially disagree; UI flags it." },
          "cite": { "$ref": "#/$defs/cites" }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "side", "cite"],
        "properties": { "name": { "type": "string" }, "side": { "enum": ["allied", "axis", "other"] }, "role": { "type": "string" }, "cite": { "$ref": "#/$defs/cites" } }
      }
    },
    "modern": {
      "type": "array",
      "description": "Present-day places tied to the event (memorials, museums, cemeteries, surviving fortifications).",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "kind", "coordinates", "cite"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["memorial", "museum", "cemetery", "fortification", "landmark", "other"] },
          "coordinates": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "osm": { "type": "string", "pattern": "^(node|way|relation)/[0-9]+$" },
          "url": { "type": "string", "format": "uri" },
          "cite": { "$ref": "#/$defs/cites" }
        }
      }
    }
  },
  "$defs": {
    "isoTime": { "type": "string", "pattern": "^19(39|4[0-5])-[01][0-9]-[0-3][0-9](T[0-2][0-9]:[0-5][0-9](Z|[+-][0-2][0-9]:[0-5][0-9])?)?$" },
    "cites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source"],
        "properties": {
          "source": { "type": "string", "description": "id of a file in data/sources/" },
          "locator": { "type": "string", "description": "Where in the source: page, chapter, section, Wikidata property (e.g. 'P625')." },
          "quote": { "type": "string", "description": "Short supporting excerpt. Strongly encouraged for numbers." }
        }
      }
    }
  }
}
